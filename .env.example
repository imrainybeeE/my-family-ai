# GEMINI_API_KEY: required for the AI helper (chat, family profile, planner, discovery notes).
# Set it as a server-side secret where the app is deployed. It is never sent to the browser.
GEMINI_API_KEY="AIza..."

# Optional: GEMINI_MODEL, GEMINI_FALLBACK_MODEL (default gemini-3.5-flash-lite, gemini-3.1-flash-lite)
# and GEMINI_THINKING (minimal, low or medium; default minimal).
GEMINI_MODEL=""

# APP_URL: the URL where this app is hosted.
APP_URL="MY_APP_URL"
