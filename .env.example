# GEMINI_API_KEY: required for the AI helper (chat, family profile, planner, discovery notes).
# Set it as a server-side secret where the app is deployed. It is never sent to the browser.
GEMINI_API_KEY="AIza..."

# GEMINI_MODEL and GEMINI_FALLBACK_MODEL: optional; default to gemini-3.5-flash and gemini-3.5-flash-lite.
GEMINI_MODEL=""

# APP_URL: the URL where this app is hosted.
APP_URL="MY_APP_URL"
