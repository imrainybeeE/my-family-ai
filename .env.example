# ANTHROPIC_API_KEY: required for the AI helper (chat, family profile, planner, discovery notes).
# Set it as a server-side secret where the app is deployed. It is never sent to the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# ANTHROPIC_WORKSPACE_ID: only needed when the key is organisation-level rather than tied to
# one workspace. Find it in the Claude Console under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=""

# APP_URL: the URL where this app is hosted.
APP_URL="MY_APP_URL"
